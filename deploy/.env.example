# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Public name of the honeypot. Its DNS A record must point at this server and
# ports 80/443 must be reachable, or Caddy cannot get a certificate.
MIRAGE_DOMAIN=

# Generate: openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# Grafana admin password. Grafana is not published; operators reach it over the VPN.
# Generate: openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
GRAFANA_ADMIN_PASSWORD=

# Password of the read-only Postgres role Grafana uses (created by deploy.sh).
# Letters and digits only. Generate: openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
GRAFANA_DB_PASSWORD=

# UDP port of the WireGuard VPN (operators reach Grafana through it).
# MIRAGE_WG_PORT=51820

# Enrichment (optional; each source is skipped while unset). GeoLite2 files go in
# deploy/geoip/ (see its README); the paths below are inside the container.
# MIRAGE_GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
# MIRAGE_GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
# MIRAGE_ABUSEIPDB_API_KEY=

# Tier 1 model server. Load the model once: deploy/ollama/pull-model.sh
# OLLAMA_VERSION=0.12.6
# MIRAGE_TIER1_ENABLED=false
# MIRAGE_LLM_LOCAL__MODEL=qwen2.5:7b

MIRAGE_ENVIRONMENT=prod
MIRAGE_LOG_LEVEL=INFO

# Only for testing on a machine where 80/443 are taken.
# MIRAGE_HTTP_PORT=80
# MIRAGE_HTTPS_PORT=443
