# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Public name of the honeypot. Its DNS A record must point at this server and
# ports 80/443 must be reachable, or Caddy cannot get a certificate.
MIRAGE_DOMAIN=

# Generate: openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# Grafana admin password. Grafana is not published; operators reach it over the VPN.
# Generate: openssl rand -base64 33 | tr -d '/+=' | cut -c1-32
GRAFANA_ADMIN_PASSWORD=

MIRAGE_ENVIRONMENT=prod
MIRAGE_LOG_LEVEL=INFO

# Only for testing on a machine where 80/443 are taken.
# MIRAGE_HTTP_PORT=80
# MIRAGE_HTTPS_PORT=443
