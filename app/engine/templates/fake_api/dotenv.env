# ShopNest storefront API
NODE_ENV=production
PORT=3000
APP_URL=https://{{ host }}

DB_HOST={{ db_host }}
DB_PORT=5432
DB_NAME=shopnest_prod
DB_USER=shopnest_app
DB_PASSWORD={{ db_password }}

REDIS_URL=redis://:{{ redis_password }}@{{ redis_host }}:6379/0

JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN=1h

SMTP_HOST=smtp.{{ host }}
SMTP_PORT=587
SMTP_USER=noreply@{{ host }}
SMTP_PASS={{ smtp_password }}
